<component name="ProjectRunConfigurationManager">
  <configuration
    default="false"
    name="Debug CLI (Compiled)"
    type="NodeJSConfigurationType"
    path-to-js-file="dist/index.js"
    working-dir="$PROJECT_DIR$/packages/cli"
  >
    <envs>
      <env name="LOG_LEVEL" value="debug"/>
    </envs>
    <method v="2">
      <option
        name="RunConfigurationTask"
        enabled="true"
        run_configuration_name="npm: build:debug (CLI)"
        run_configuration_type="js.build_tools.npm"
      />
    </method>
  </configuration>
</component>
