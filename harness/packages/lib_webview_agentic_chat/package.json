{
  "name": "@gitlab-org/lib-agentic-duo-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugin": "tsdown --tsconfig tsconfig.plugin.json",
    "build:webview": "vite build",
    "dev": "vite",
    "test": "bun run test:app && bun run test:plugin",
    "test:app": "jest --config jest.app.config.cjs",
    "test:plugin": "jest --config jest.plugin.config.cjs",
    "test:app:watch": "jest --config jest.app.config.cjs --watch",
    "test:plugin:watch": "jest --config jest.plugin.config.cjs --watch",
    "watch": "vite --config vite.config.ts build --watch",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@gitlab-lsp/workflow-api": "0.0.0",
    "@gitlab-org/ai-configuration": "0.0.0",
    "@gitlab-org/ai-context": "0.0.0",
    "@gitlab-org/core": "0.0.0",
    "@gitlab-org/graphql": "0.0.0",
    "@gitlab-org/tool-approval": "0.0.0",
    "@gitlab-org/logging": "0.0.0",
    "@gitlab-org/message-bus": "0.0.0",
    "@gitlab-org/persistent-storage": "0.0.0",
    "@gitlab-org/sandbox": "0.0.0",
    "@gitlab-org/secret-redaction": "0.0.0",
    "@gitlab-org/telemetry": "0.0.0",
    "@gitlab-org/test-utils": "0.0.0",
    "@gitlab-org/vite-common-config": "0.0.0",
    "@gitlab-org/webview-plugin": "0.0.0",
    "@gitlab/duo-ui": "^15.25.0",
    "@gitlab/ui": "^124.4.0",
    "@pinia/testing": "^0.1.7",
    "@ts-stack/markdown": "^1.5.0",
    "dompurify": "^3.1.7",
    "graphql-request": "^7.1.2",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.0",
    "marked-bidi": "^1.0.8",
    "pinia": "^2.2.5",
    "semver": "^7.7.3",
    "tailwindcss": "^3.4.1",
    "uuid": "^11.0.5",
    "v-tooltip": "^2.1.3",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@gitlab-org/webview-client": "0.0.0",
    "@gitlab/svgs": "^3.122.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "eslint": "^8.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.77.8",
    "ts-jest": "^29.2.5",
    "vite": "^3.0.2",
    "vue-template-compiler": "^2.7.16"
  },
  "exports": {
    ".": {
      "_ts-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./contract": {
      "_ts-source": "./src/contract.ts",
      "default": "./dist/contract.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./contract": "./dist/contract.mjs",
      "./package.json": "./package.json"
    }
  }
}
