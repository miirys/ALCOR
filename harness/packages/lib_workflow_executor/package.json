{
  "name": "@gitlab-org/workflow-executor",
  "version": "0.0.0",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@gitlab-lsp/workflow-api": "0.0.0",
    "@gitlab-org/ai-configuration": "0.0.0",
    "@gitlab-org/ai-context": "0.0.0",
    "@gitlab-org/config": "0.0.0",
    "@gitlab-org/core": "0.0.0",
    "@gitlab-org/disposable": "0.0.0",
    "@gitlab-org/document": "0.0.0",
    "@gitlab-org/duo-workflow-service": "0.1.51",
    "@gitlab-org/errors": "0.0.0",
    "@gitlab-org/fetch": "0.0.0",
    "@gitlab-org/fs": "0.0.0",
    "@gitlab-org/graphql": "0.0.0",
    "@gitlab-org/logging": "0.0.0",
    "@gitlab-org/repositories": "0.0.0",
    "@gitlab-org/resiliency": "0.0.0",
    "@gitlab-org/secret-redaction": "0.0.0",
    "@gitlab-org/telemetry": "0.0.0",
    "@gitlab-org/tool-approval": "0.0.0",
    "@gitlab/needle": "2.0.0",
    "lodash-es": "^4.18.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/ws": "^8.18.1",
    "@gitlab-org/test-utils": "0.0.0",
    "ts-proto": "^2.7.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "exports": {
    ".": {
      "_ts-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "_ts-source": "./src/node.ts",
      "default": "./dist/node.mjs"
    },
    "./violations": {
      "_ts-source": "./src/violations/public.ts",
      "default": "./dist/violations.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./node": "./dist/node.mjs",
      "./violations": "./dist/violations.mjs",
      "./package.json": "./package.json"
    }
  }
}
