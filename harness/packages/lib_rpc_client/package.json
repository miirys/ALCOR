{
  "name": "@gitlab-org/rpc-client",
  "version": "0.0.0",
  "type": "module",
  "description": "RPC client library",
  "dependencies": {
    "@gitlab-org/rpc": "0.0.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "exports": {
    ".": {
      "_ts-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
