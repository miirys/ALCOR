{
  "name": "@gitlab-org/repositories",
  "version": "0.0.0",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@gitlab-org/config": "0.0.0",
    "@gitlab-org/core": "0.0.0",
    "@gitlab-org/disposable": "0.0.0",
    "@gitlab-org/fs": "0.0.0",
    "@gitlab-org/logging": "0.0.0",
    "@gitlab-org/secret-redaction": "0.0.0",
    "@gitlab-org/test-utils": "0.0.0",
    "@gitlab/needle": "2.0.0",
    "lodash-es": "^4.18.1",
    "isomorphic-git": "^1.32.3",
    "minimatch": "^10.0.1",
    "simple-git": "^3.28.0",
    "shell-quote": "^1.8.3",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.17.30",
    "@types/shell-quote": "^1.7.5"
  },
  "scripts": {
    "build": "tsdown"
  },
  "exports": {
    ".": {
      "_ts-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "_ts-source": "./src/browser.ts",
      "default": "./dist/browser.mjs"
    },
    "./node": {
      "_ts-source": "./src/node.ts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./browser": "./dist/browser.mjs",
      "./node": "./dist/node.mjs",
      "./package.json": "./package.json"
    }
  }
}
