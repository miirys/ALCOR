{
  "grammars": [
    {
      "name": "@gitlab-org/gitlab-lsp",
      "camelcase": "GitlabOrgGitlabLsp",
      "scope": "source.cfengine",
      "path": ".",
      "file-types": ["cf"]
    }
  ],
  "metadata": {
    "version": "7.4.0",
    "license": "MIT",
    "description": "Language Server for GitLab",
    "authors": [
      {
        "name": "GitLab"
      }
    ],
    "links": {
      "repository": "https://gitlab.com/gitlab-org/editor-extensions/gitlab-language-server-for-code-suggestions.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
