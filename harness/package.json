{
  "name": "@gitlab-org/gitlab-lsp",
  "description": "Language Server for GitLab",
  "version": "8.111.0",
  "author": "GitLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/gitlab-org/editor-extensions/gitlab-language-server-for-code-suggestions.git"
  },
  "packageManager": "bun@1.3.10",
  "main": "./out/common/index.js",
  "bin": {
    "gitlab-lsp": "./out/main-bundle-node.js"
  },
  "workspaces": [
    "packages/*",
    "src/common",
    "src/node",
    "src/browser"
  ],
  "typings": "./out/gitlab-lsp.d.ts",
  "files": [
    "vendor",
    "out",
    "docs",
    "CHANGELOG.md",
    "package.json"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.62",
    "@anycable/core": "^0.9.2",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@fastify/rate-limit": "^10.3.0",
    "@gitlab/needle": "2.0.0",
    "@sentry/esbuild-plugin": "^4.3.0",
    "@types/chai": "^5.2.2",
    "@vscode/ripgrep": "^1.17.1",
    "chai": "^6.2.2",
    "confbox": "^0.2.2",
    "cross-fetch": "^4.1.0",
    "fastify": "^5.6.1",
    "fdir": "^6.4.6",
    "get-proxy-settings": "^0.1.13",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "ini": "^4.1.3",
    "isomorphic-ws": "^5.0.0",
    "js-yaml": "^4.2.0",
    "minimatch": "^10.0.3",
    "proxy-agent": "^6.5.0",
    "semver": "^7.7.3",
    "simple-git": "^3.28.0",
    "ssh-config": "5.0.4",
    "typescript": "^5.8.3",
    "uuid": "^10.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "^0.24.7",
    "zod": "^4.4.1"
  },
  "overrides": {
    "tree-sitter": "0.25.0",
    "isomorphic-git": "1.32.3",
    "@fastify/static": "8.2.0",
    "@vue/compiler-core": "^3.5.32",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.34.0"
  },
  "trustedDependencies": [],
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@dotenvx/dotenvx": "^1.50.1",
    "@gitlab/eslint-plugin": "^21.3.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@microsoft/api-extractor": "^7.52.3",
    "@parcel/watcher": "^2.5.6",
    "@rollup/plugin-babel": "^7.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.7",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@sentry/cli": "^3.4.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/fuzzaldrin-plus": "^0.6.5",
    "@types/ini": "^4.1.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.14.30",
    "@types/semver": "^7.7.1",
    "@types/source-map-support": "^0.5.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.34.0",
    "async": "^3.2.6",
    "babel-jest": "^29.7.0",
    "buffer": "^6.0.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "concurrently": "^8.2.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "dedent": "^1.6.0",
    "esbuild": "^0.27.3",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^9.29.0",
    "eslint-formatter-gitlab": "^6.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "~10.5.0",
    "execa": "^9.3.1",
    "fs-extra": "^11.3.5",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lefthook": "^1.7.15",
    "mocha": "^11.7.2",
    "mocha-headless-chrome": "^5.1.0",
    "prettier": "3.6.1",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.7",
    "semantic-release-slack-bot": "^4.0.2",
    "tcp-port-used": "^1.0.2",
    "ts-node": "^10.9.2",
    "tsdown": "^0.21.7",
    "tsx": "^4.20.4",
    "turbo": "^2.9.5",
    "type-fest": "^4.41.0",
    "ws": "^8.18.1"
  },
  "scripts": {
    "prepare": "test -n \"$CI\" || (node scripts/git_blame_ignore.mjs && lefthook install)",
    "start": "mise run start",
    "start:dev": "mise run start:dev",
    "debug": "mise run debug",
    "watch": "tsx scripts/turbo/turbo_watch.ts",
    "theming": "echo 'Deprecated: use `bun run watch` instead' && exit 1",
    "duo:agentic-chat": "echo 'Deprecated: use `bun run watch` instead' && exit 1",
    "build:language-server-only": "echo 'Deprecated: use `bun run build` instead (turbo handles caching)' && exit 1",
    "build:package": "echo 'Use: bun run --filter <pkg> build'",
    "compile": "bun run turbo -- run build",
    "compile:scripts": "tsc -p scripts --noEmit",
    "compile:integration": "tsc -p src/common --noEmit && tsc -p src/node --noEmit && tsc -p src/tests --noEmit",
    "build": "bun run turbo -- run //#tb:api-extract",
    "eslint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --report-unused-disable-directives",
    "eslint:fix": "eslint --fix",
    "prettier": "prettier --check '**/*.{js,ts,tsx,json,vue,scss}'",
    "prettier:fix": "prettier --write '**/*.{js,ts,tsx,json,vue,scss}'",
    "autofix": "bun run eslint:fix && bun run prettier:fix",
    "test": "bun run test:unit && bun run test:integration && bun run test:cli",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:unit:watch": "jest --watch --config jest.unit.config.ts",
    "test:build:integration": "bun run build && bun run test:integration",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:integration:git": "jest --config jest.integration.config.ts --testMatch=\"**/src/tests/int/git/**/*.test.ts\"",
    "test:integration:persistent-storage": "jest --config jest.integration.config.ts --testMatch=\"**/src/tests/int/persistent_storage/**/*.test.ts\"",
    "test:integration:sandbox": "jest --config jest.integration.config.ts --testMatch=\"**/src/tests/int/sandbox_read_policy_boundary.test.ts\"",
    "test:integration:browser:prepare": "dotenvx run -f .env.local -f .env -- tsx ./scripts/prepare_browser_e2e_tests.ts",
    "test:integration:browser:http-server": "http-server tmp/tests/browser -c-1 --cors -p 9010",
    "test:integration:browser:run": "mocha-headless-chrome -f http://localhost:9010 -o reports/unit.xml -r xunit -a ignore-ssl-errors -a no-sandbox -a disable-setuid-sandbox",
    "test:integration:browser": "bun run compile && bun run test:integration:browser:prepare && concurrently --kill-others --success first \"bun run test:integration:browser:http-server\" \"bun run test:integration:browser:run\"",
    "test:integration:browser:watch": "concurrently \"mise watch --glob 'src/tests/browser/**/*' -- prepare:browser-e2e\" \"bun run test:integration:browser:http-server\"",
    "test:file": "scripts/dev/test-file.sh",
    "test:cli": "bun run --filter @gitlab-org/tui test && bun run --filter @gitlab/duo-cli test",
    "test:chat:app": "bun run --filter @gitlab-org/webview-duo-chat-classic test:app",
    "test:chat:plugin": "bun run --filter @gitlab-org/webview-duo-chat-classic test:plugin",
    "test:agentic-chat:app": "jest --config packages/lib_webview_agentic_chat/jest.app.config.cjs",
    "test:agentic-chat:plugin": "jest --config packages/lib_webview_agentic_chat/jest.plugin.config.cjs",
    "test:agentic-tabs:app": "jest --config packages/webview_agentic_tabs/jest.app.config.cjs",
    "test:agentic-tabs:plugin": "jest --config packages/webview_agentic_tabs/jest.plugin.config.cjs",
    "test:agentic-lib:app": "jest --config packages/lib_webview_agentic_chat/jest.app.config.cjs",
    "test:agentic-lib:plugin": "jest --config packages/lib_webview_agentic_chat/jest.plugin.config.cjs",
    "test:storybook:webview": "bun run --filter @gitlab-org/language-server-webview test:storybook",
    "test:unit:webview": "bun run --filter @gitlab-org/language-server-webview test:unit",
    "bundle:browser": "bun run turbo -- run bundle --filter=@gitlab-org/legacy-browser",
    "bundle:desktop": "bun run turbo -- run bundle --filter=@gitlab-org/legacy-node",
    "bundle:common": "bun run turbo -- run bundle --filter=@gitlab-org/legacy-common",
    "bundle": "bun run turbo -- run bundle",
    "generate:documentation": "tsx --tsconfig ./scripts/tsconfig.json scripts/documentation/main.ts",
    "cli": "bun run turbo -- run bundle --filter=@gitlab/duo-cli && node --use-system-ca packages/cli/dist/index.js",
    "cli:watch": "bun run --filter @gitlab/duo-cli dev:watch",
    "cli:dev": "bun run --filter @gitlab/duo-cli dev:watch-tools",
    "cli:package": "bun run turbo -- run bundle --filter=@gitlab/duo-cli && cd packages/cli && bun pm pack --destination ../..",
    "cli:debug": "bun run turbo -- run build:debug --filter=@gitlab/duo-cli && node --inspect-brk=127.0.0.1:9229 packages/cli/dist/index.js",
    "cli:compile": "bun run turbo -- run build:binary --filter=@gitlab/duo-cli",
    "cli:sign": "bun run --filter @gitlab/duo-cli sign:binary",
    "cli:glab": "bun run turbo -- run build:dev-binary --filter=@gitlab/duo-cli && GLAB_DUO_CLI_BINARY_PATH=packages/cli/bin/duo-native glab duo cli",
    "turbo": "TURBO_TELEMETRY_DISABLED=1 turbo",
    "clean": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/turbo/turbo_clean.ts",
    "semantic-release": "semantic-release",
    "version": "node scripts/set_ls_version.js",
    "clear_node_modules": "rm -rf ./node_modules && find ./packages -type d -name node_modules -exec rm -rf {} +",
    "install:clean": "bun run clear_node_modules && bun install",
    "tb:api-extract": "tsx --tsconfig ./scripts/tsconfig.json scripts/generate_api_extractor_config.ts && api-extractor run --local",
    "tb:sync-assets-to-ide": "tsx scripts/turbo/sync_assets_to_ide.mts"
  }
}
