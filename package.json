{
  "name": "alcor",
  "version": "0.1.0",
  "description": "ALCOR — a refined terminal UI for an agent harness",
  "type": "module",
  "bin": { "alcor": "./src/index.tsx" },
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/index.tsx",
    "start:bun": "bun src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
